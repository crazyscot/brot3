digraph {
    compound = true;

    node [shape = box;];
    ui
    lib
    idl
    #xtask [style = dashed];

    shader [shape=component]

    {
        #rank=same;
        lib
        shader
        easy_shader_runner [style=filled]

    }

    node [style=filled];
    easy_shader_runner
    egui_winit

    #########################

    edge [fontname = "arial"; fontsize = 7;];
    ui -> lib -> idl
    ui -> easy_shader_runner;
    ui -> egui_winit;

    easy_shader_runner -> shader [style=dashed; label="uses"]
    lib -> shader [style=dashed; label="prepares"]
}
